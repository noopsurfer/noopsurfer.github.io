---
import "@fontsource/google-sans/400.css";
import "@fontsource/google-sans/700.css";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/global.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>noopsurfer</title>
    <script is:inline>
      // Resolve theme: localStorage → system preference → light (default).
      let t = localStorage.getItem("theme");
      if (!t) {
        t = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        localStorage.setItem("theme", t);
      }
      document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <main>
      <header style="border-bottom: 1px solid var(--color-border);">
        <nav style="font-size: 1.25em; font-weight: 700;">
          <ThemeSwitcher /> • 
          <a href="/">🏠</a> • 
          <a href="/pages">pages</a> • 
          <a href="/about">about</a>
        </nav>
      </header>
      <slot />
    </main>
    <footer style="border-top: 1px solid var(--color-border);">
      <div style="text-align: right;">noopsurfer, all rights reserved {year}</div>
    </footer>
  </body>
</html>

<style>
  html,
  body {
    /* To fill the viewport. */
    height: 100%;
  }
  body {
    font-family: "Google Sans", sans-serif;
    font-weight: 400;
    /* To stack children vertically. */
    display: flex;
    flex-direction: column;
    /* Constrain width and center on wide screens. */
    max-width: 800px;
    /* min-width: 600px; */
    margin: 0 auto; /* centers the body horizontally when the viewport exceeds max-width */
    /* Enable container queries for responsive typography. */
    container-type: inline-size;
  }
  body :is(h1, h2, h3, h4, h5, h6) {
    font-weight: 700;
  }
  main {
    /* To take all available space. */
    flex: 1 0 auto;
  }
  footer {
    /* To prevent the footer from shrinking, so it never gets squished. */
    flex-shrink: 0;
  }

  /* Responsive typography based on the body container width. Headings using em will scale proportionally. */
  main,
  footer {
    font-size: 16px; /* base: 600px–899px */
  }
  /* @container (min-width: 900px) {
    main,
    footer {
      font-size: 18px;
    }
  }
  @container (min-width: 1200px) {
    main,
    footer {
      font-size: 20px;
    }
  } */
</style>
